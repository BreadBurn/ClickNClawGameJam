[node name="IntroInfo" parent="Talkables" unique_id=164483212 instance=ExtResource("9_ux5qa")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -30.045444, 1.8578033, -29.740726)
npc_name = "Game Introduction"
dialogue_text = "You are in charge of reintroducing 4 native species that have been long gone from this ecosystem, plant everyday and check your progress by sleeping!
Ensure that each plant reaches a ~25% ratio (10% - 40%). If all plants keep this ratio for 3 days, youve sucessfully managed to introduce the native species back in its ecosystem and won the game!
Work that relates to your ecosystem task consumes stamina (planting [right click on field] and collecting [left click on field]). Replenish it back to full by sleeping! (You can sleep by entering the house [left click on door] and sleeping [left click on bed])"

[node name="IntroInfo2" parent="Talkables" unique_id=1719319179 instance=ExtResource("9_ux5qa")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -36.534645, 1.8578033, -17.905563)
npc_name = "About Plants"
dialogue_text = "The regioned enclosed by the pathway down the hill is your planting ground. For a plant, you maya collect it [left click on bed][Consumes stamina]or plant [right click on field][Consumes stamina]. Select what you want to plant by pressing 1, 2, 3 or 4 on the keyboard."

